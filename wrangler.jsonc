{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appss",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7a34362b-8eea-4e95-b8fd-032bdf89d23d","database_name": "web-appss" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6bc40791705c424d9450f5e382a8e109" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
